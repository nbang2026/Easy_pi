{
  "name": "pi-app",
  "private": true,
  "version": "1.0.3",
  "description": "A Tauri desktop workbench for the Pi coding agent with graphical controls and a full terminal interface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbang2026/Easy_pi.git"
  },
  "homepage": "https://github.com/nbang2026/Easy_pi#readme",
  "bugs": {
    "url": "https://github.com/nbang2026/Easy_pi/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "windows-runtime:check": "node scripts/prepare-windows-runtime.mjs --check",
    "windows-runtime:prepare": "node scripts/prepare-windows-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "fflate": "0.8.2",
    "lucide": "1.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
