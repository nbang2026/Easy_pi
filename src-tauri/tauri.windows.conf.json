{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build && node scripts/prepare-windows-runtime.mjs --check"
  },
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": {
      "runtime/windows-x64": "runtime/windows-x64"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "active": false
  }
}
