{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build && node scripts/prepare-windows-runtime.mjs --check && node scripts/prepare-claude-runtime.mjs --platform win32 --arch x64 --check"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "runtime/windows-x64": "runtime/windows-x64",
      "claude-runtime": "claude-runtime"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
